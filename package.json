{
  "name": "dokonly",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:miniapp": "pnpm --filter miniapp dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm build:miniapp",
    "build:miniapp": "pnpm --filter miniapp build",
    "build:dashboard": "pnpm --filter dashboard build",
    "dev:web-storefront": "pnpm --filter web-storefront dev",
    "build:web-storefront": "pnpm --filter web-storefront build",
    "deploy": "pnpm deploy:miniapp",
    "deploy:miniapp": "pnpm build:miniapp && wrangler pages deploy apps/miniapp/dist --project-name dokonly-miniapp --branch ${CF_PAGES_BRANCH:-main}",
    "deploy:dashboard": "pnpm build:dashboard && wrangler pages deploy apps/dashboard/dist --project-name dokonly-dashboard --branch ${CF_PAGES_BRANCH:-main}",
    "deploy:worker": "wrangler deploy",
    "wrangler:check": "wrangler check",
    "wrangler:whoami": "wrangler whoami",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "wrangler": "^4.94.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
