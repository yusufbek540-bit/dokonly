{
  "$schema_version": "1.0",
  "$description": "Dokonly business spheres seed. 15 categories with theme defaults (Storefront Theme System §9.0), default product attributes, sphere-specific onboarding hints. Used in onboarding wizard step 2 (sphere selection) to preselect step 5 (visual identity) defaults.",
  "$last_updated": "2026-05-14",
  "$total_count": 15,
  "$translations_languages": ["ru", "uz", "en"],

  "$theme_options_reference": {
    "typography_bundles": ["modern", "editorial", "bold", "warm", "minimal"],
    "accent_colors": [
      "forest", "emerald", "mint", "lime",
      "ocean", "sky", "indigo",
      "sunset", "coral", "rose",
      "graphite", "sand"
    ],
    "layouts": ["boutique", "catalog", "lookbook", "marketplace", "bento"]
  },

  "$layout_descriptions": {
    "boutique": "Fashion-forward, photo-heavy, vertical product cards",
    "catalog": "Specs and filters, organized, compact density",
    "lookbook": "Story-driven, lifestyle imagery first",
    "marketplace": "Many products, fast browsing, grid 2x2",
    "bento": "Magazine-style, mixed card sizes"
  },

  "$attribute_descriptions": {
    "size": "Product size (clothing/shoes — XS/S/M/L/XL or 36-46)",
    "color": "Product color (free-form or predefined palette)",
    "material": "Material (cotton, leather, plastic, etc.)",
    "brand": "Brand name (Samsung, Apple, Nike, etc.)",
    "model": "Specific model identifier",
    "specifications": "Technical specs (free-form text)",
    "warranty": "Warranty period (months/years)",
    "volume": "Volume/capacity (ml, L)",
    "weight": "Weight (g, kg)",
    "scent": "Scent/fragrance type",
    "skin_type": "Skin type (oily, dry, sensitive, etc.)",
    "dimensions": "Length × Width × Height",
    "car_brand": "Car brand (for auto parts)",
    "car_model": "Car model (for auto parts)",
    "year": "Year (model year, publication year)",
    "compatible": "Compatibility list",
    "age": "Age group (newborn, 1-3y, 4-6y, etc.)",
    "gender": "Gender (boy/girl/unisex)",
    "pet_type": "Pet type (dog, cat, bird, etc.)",
    "author": "Book author",
    "publisher": "Publisher name",
    "language": "Content language",
    "expiry_date": "Expiration date",
    "ingredients": "Ingredients list (food/cosmetics)",
    "duration_minutes": "Service duration in minutes"
  },

